EIGS.xiSimpleGraph_mesoscopic_ball_birth_spectral_volume {K : ℕ} (system : EIGS.EIGSData K)
  (rule_connected : ∀ (colour : Fin K), (EIGS.ruleSG system colour).Connected)
  (rules_loopless : ∀ (colour : Fin K), (system.ruleNetwork colour).Loopless)
  (rules_unique : ∀ (colour : Fin K), (system.ruleNetwork colour).EdgesUnique)
  (planting_nonadjacent :
    ∀ (colour : Fin K), ¬(EIGS.ruleSG system colour).Adj (system.plantPlus colour) (system.plantMinus colour))
  (distance_positive :
    ∀ (ruleColour edgeColour : Fin K),
      ¬((system.ruleNetwork ruleColour).withoutColour edgeColour).Reachable (system.plantPlus ruleColour)
          (system.plantMinus ruleColour))
  (primitive_degree : (EIGS.degreeMatrix system).IsPrimitive) (radius_lower radius_upper : ℝ)
  (radius_lower_positive : 0 < radius_lower) (radius_upper_positive : 0 < radius_upper) :
  ∃ buffer,
    ∀ (initial_level : ℕ) (vertex : EIGS.XiVtx system initial_level),
      ∃ lower upper,
        0 < lower ∧
          0 < upper ∧
            ∀ (age depth : ℕ) (radius : ℝ),
              buffer ≤ age →
                1 < radius →
                  radius_lower * system.distanceSpectralRadius rule_connected ^ depth ≤ radius →
                    radius ≤ radius_upper * system.distanceSpectralRadius rule_connected ^ depth →
                      lower * EIGS.finiteRealMatrixSpectralRadius (EIGS.degreeMatrix system) ^ age *
                            EIGS.realMatrixSpectralRadius (EIGS.massMatrixR system.toRuleData) ^ depth ≤
                          ↑(EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                (EIGS.xiForward system initial_level (age + depth) vertex) radius).card ∧
                        ↑(EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                (EIGS.xiForward system initial_level (age + depth) vertex) radius).card ≤
                          upper * EIGS.finiteRealMatrixSpectralRadius (EIGS.degreeMatrix system) ^ age *
                            EIGS.realMatrixSpectralRadius (EIGS.massMatrixR system.toRuleData) ^ depth
EIGS.xiSimpleGraph_mesoscopic_ball_birth_spectral_resistance {K : ℕ} (system : EIGS.EIGSData K)
  (rule_connected : ∀ (colour : Fin K), (EIGS.ruleSG system colour).Connected)
  (rules_loopless : ∀ (colour : Fin K), (system.ruleNetwork colour).Loopless)
  (rules_unique : ∀ (colour : Fin K), (system.ruleNetwork colour).EdgesUnique)
  (planting_nonadjacent :
    ∀ (colour : Fin K), ¬(EIGS.ruleSG system colour).Adj (system.plantPlus colour) (system.plantMinus colour))
  (distance_positive :
    ∀ (ruleColour edgeColour : Fin K),
      ¬((system.ruleNetwork ruleColour).withoutColour edgeColour).Reachable (system.plantPlus ruleColour)
          (system.plantMinus ruleColour))
  (primitive_degree : (EIGS.degreeMatrix system).IsPrimitive) (radius_lower radius_upper : ℝ)
  (radius_lower_positive : 0 < radius_lower) (radius_upper_positive : 0 < radius_upper) :
  ∃ buffer,
    ∀ (initial_level : ℕ) (vertex : EIGS.XiVtx system initial_level),
      ∃ lower upper,
        0 < lower ∧
          0 < upper ∧
            ∀ (age depth : ℕ) (radius : ℝ),
              buffer ≤ age →
                buffer ≤ depth →
                  1 < radius →
                    radius_lower * system.distanceSpectralRadius rule_connected ^ depth ≤ radius →
                      radius ≤ radius_upper * system.distanceSpectralRadius rule_connected ^ depth →
                        (EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                (EIGS.xiForward system initial_level (age + depth) vertex) radius)ᶜ.Nonempty ∧
                          lower * system.resistanceSpectralRadius rule_connected distance_positive ^ depth /
                                EIGS.finiteRealMatrixSpectralRadius (EIGS.degreeMatrix system) ^ age ≤
                              EIGS.effResToBoundary (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                (EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                  (EIGS.xiForward system initial_level (age + depth) vertex) radius)
                                (EIGS.xiForward system initial_level (age + depth) vertex) ∧
                            EIGS.effResToBoundary (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                (EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + (age + depth)))
                                  (EIGS.xiForward system initial_level (age + depth) vertex) radius)
                                (EIGS.xiForward system initial_level (age + depth) vertex) ≤
                              upper * system.resistanceSpectralRadius rule_connected distance_positive ^ depth /
                                EIGS.finiteRealMatrixSpectralRadius (EIGS.degreeMatrix system) ^ age
EIGS.xiSimpleGraph_fixed_radius_resistance_spectral_bounds {K : ℕ} (system : EIGS.EIGSData K)
  (rule_connected : ∀ (colour : Fin K), (EIGS.ruleSG system colour).Connected)
  (rules_loopless : ∀ (colour : Fin K), (system.ruleNetwork colour).Loopless)
  (rules_unique : ∀ (colour : Fin K), (system.ruleNetwork colour).EdgesUnique)
  (planting_nonadjacent :
    ∀ (colour : Fin K), ¬(EIGS.ruleSG system colour).Adj (system.plantPlus colour) (system.plantMinus colour))
  (distance_positive :
    ∀ (ruleColour edgeColour : Fin K),
      ¬((system.ruleNetwork ruleColour).withoutColour edgeColour).Reachable (system.plantPlus ruleColour)
          (system.plantMinus ruleColour))
  (primitive_degree : (EIGS.degreeMatrix system).IsPrimitive) (radius : ℝ) (radius_gt_one : 1 < radius) :
  ∃ threshold,
    ∀ (initial_level : ℕ) (vertex : EIGS.XiVtx system initial_level),
      ∃ lower upper,
        0 < lower ∧
          0 < upper ∧
            ∀ (age : ℕ),
              threshold ≤ age →
                (EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + age))
                        (EIGS.xiForward system initial_level age vertex) radius)ᶜ.Nonempty ∧
                  lower * (EIGS.finiteRealMatrixSpectralRadius (EIGS.degreeMatrix system))⁻¹ ^ age ≤
                      EIGS.effResToBoundary (EIGS.XiSimpleGraph system (initial_level + age))
                        (EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + age))
                          (EIGS.xiForward system initial_level age vertex) radius)
                        (EIGS.xiForward system initial_level age vertex) ∧
                    EIGS.effResToBoundary (EIGS.XiSimpleGraph system (initial_level + age))
                        (EIGS.finiteGraphBall (EIGS.XiSimpleGraph system (initial_level + age))
                          (EIGS.xiForward system initial_level age vertex) radius)
                        (EIGS.xiForward system initial_level age vertex) ≤
                      upper * (EIGS.finiteRealMatrixSpectralRadius (EIGS.degreeMatrix system))⁻¹ ^ age
