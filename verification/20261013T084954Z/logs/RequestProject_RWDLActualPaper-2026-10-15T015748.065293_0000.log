Cluster.connected_actual_terminal_expectations_equal (n : ℕ) :
  ∫ (configuration : Cluster.Conf n), ↑(Cluster.net n configuration).sourceTailCount ∂Cluster.connectedMeasure n =
    ∫ (configuration : Cluster.Conf n), ↑(Cluster.net n configuration).sinkHeadCount ∂Cluster.connectedMeasure n
